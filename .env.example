POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=TrocarEssaSenhaAntesDeSubir123!

# Portas expostas no host. Troque se já estiverem em uso por outro serviço.
ZABBIX_WEB_PORT=8080
ZABBIX_SERVER_PORT=10051
GRAFANA_PORT=3000

# Credenciais iniciais do Grafana (troque o padrão admin/admin)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=TrocarEssaSenhaAntesDeSubir123!

# SSO/SAML do Zabbix (opcional). Deixe vazio se não usar SSO.
# Coloque o certificado do IdP em ./certs/idp.crt antes de habilitar.
ZBX_SSO_SETTINGS='{"baseurl": "http://SEU_IP_OU_DOMINIO:PORTA"}'
